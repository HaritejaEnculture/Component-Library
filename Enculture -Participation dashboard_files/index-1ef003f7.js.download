        .actions-list-container {
          padding: 20px 0;
        }
        
        .priority-group {
          margin-bottom: 32px;
        }
        
        .priority-group:last-child {
          margin-bottom: 0;
        }
        
        .priority-group-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 0 4px 12px 4px;
          border-bottom: 1px solid rgba(139, 92, 246, 0.15);
          margin-bottom: 16px;
        }
        
        .priority-title {
          font-family: 'Poppins', sans-serif;
          font-size: 14px;
          font-weight: 600;
          color: #64748b;
          margin: 0;
