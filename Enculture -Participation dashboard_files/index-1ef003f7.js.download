        .table-view-container-new {
          width: 100%;
          overflow-x: auto;
          background: rgba(249, 250, 251, 0.8);
          border-radius: 16px;
          border: 2px solid rgba(139, 92, 246, 0.2);
        }
        
        .actions-table-new {
          width: 100%;
          border-collapse: separate;
          border-spacing: 0;
          font-family: 'Poppins', sans-serif;
        }
        
        /* Header Styles */
        .actions-table-new thead {
          background: rgba(139, 92, 246, 0.05);
          border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        }
        
        .actions-table-new th {
          padding: 16px 20px;
          text-align: left;
          font-size: 12px;
          font-weight: 600;
          color: #64748b;
          text-transform: uppercase;
          letter-spacing: 0.5px;
          cursor: pointer;
          transition: all 0.2s;
          border-right: 1px solid rgba(226, 232, 240, 0.6);
          user-select: none;
        }
        
        .actions-table-new th:last-child {
          border-right: none;
        }
        
        .actions-table-new th:hover {
          background: rgba(139, 92, 246, 0.1);
          color: #8B5CF6;
        }
        
        .th-checkbox {
          width: 60px;
          text-align: center;
          cursor: default !important;
        }
        
        .th-checkbox:hover {
          background: transparent !important;
        }
        
        .th-title {
          min-width: 300px;
          width: 40%;
        }
        
        .th-priority {
          width: 120px;
        }
        
        .th-status {
          width: 140px;
        }
        
        .th-category {
          width: 140px;
        }
        
        .th-due-date {
          width: 140px;
        }
        
        .th-content-new {
          display: flex;
          align-items: center;
          gap: 8px;
          justify-content: flex-start;
        }
        
        /* Body Styles */
        .actions-table-new tbody tr {
          background: white;
          border-bottom: 1px solid rgba(226, 232, 240, 0.6);
          transition: all 0.2s;
          cursor: pointer;
        }
        
        .actions-table-new tbody tr:hover {
          background: rgba(139, 92, 246, 0.05);
          transform: translateX(4px);
        }
        
        .actions-table-new td {
          padding: 16px 20px;
          color: #1e293b;
          font-size: 14px;
          border-right: 1px solid rgba(226, 232, 240, 0.6);
          vertical-align: middle;
        }
        
        .actions-table-new td:last-child {
          border-right: none;
        }
        
        /* Checkbox Cell */
        .td-checkbox {
          text-align: center;
          padding: 12px;
        }
        
        .checkbox-btn-elevated {
          background: transparent;
          border: none;
          padding: 0;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: transform 0.2s ease;
        }
        
        .checkbox-btn-elevated:hover {
          transform: scale(1.1);
        }
        
        .checkbox-circle-table {
          width: 22px;
          height: 22px;
          border-radius: 50%;
          border: 2.5px solid #cbd5e1;
          background: white;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .checkbox-circle-table:hover {
          border-color: #8B5CF6;
          background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), rgba(168, 85, 247, 0.05));
          box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1), 0 2px 8px rgba(139, 92, 246, 0.15);
        }
        
        .checkbox-circle-table.checked {
          border-color: #10b981;
          background: linear-gradient(135deg, #10b981 0%, #059669 100%);
          box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15), 0 4px 12px rgba(16, 185, 129, 0.3);
          animation: checkboxPopTable 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }
        
        .checkbox-circle-table.checked:hover {
          background: linear-gradient(135deg, #059669 0%, #047857 100%);
          box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.2), 0 6px 16px rgba(16, 185, 129, 0.4);
        }
        
        .checkmark-svg-table {
          width: 12px;
          height: 12px;
          animation: checkmarkDrawTable 0.3s ease forwards;
        }
        
        @keyframes checkboxPopTable {
          0% {
            transform: scale(0.8);
            opacity: 0.8;
          }
          50% {
            transform: scale(1.1);
          }
          100% {
            transform: scale(1);
            opacity: 1;
          }
        }
        
        @keyframes checkmarkDrawTable {
          0% {
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
          }
          100% {
            stroke-dasharray: 100;
            stroke-dashoffset: 0;
          }
        }
        
        /* Title Cell */
        .td-title {
          font-weight: 500;
        }
        
        .title-active {
          color: #1e293b;
        }
        
        .title-completed {
          color: #94a3b8;
          text-decoration: line-through;
        }
        
        /* Priority Badge */
        .priority-badge-new {
          display: inline-block;
          padding: 6px 12px;
          border-radius: 8px;
          font-size: 11px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.5px;
          white-space: nowrap;
        }
        
        /* Status Badge */
        .status-badge-new {
          display: inline-block;
          padding: 6px 12px;
          border-radius: 8px;
          font-size: 11px;
          font-weight: 600;
          white-space: nowrap;
        }
        
        /* Category Text */
        .category-text-new {
          color: #64748b;
          font-size: 13px;
        }
        
        /* Date Text */
        .date-text-new {
          color: #64748b;
          font-size: 13px;
        }
        
        /* Loading State */
        .table-loading {
          padding: 60px;
          text-align: center;
          color: #94a3b8;
          font-family: 'Poppins', sans-serif;
        }
        
        /* Responsive */
        @media (max-width: 1024px) {
          .th-title {
            min-width: 200px;
          }
        }
