        .custom-multiselect-wrapper {
          position: relative;
          min-width: 220px;
          font-family: 'Poppins', sans-serif;
        }

        .custom-multiselect-label {
          display: block;
          font-size: 12px;
          font-weight: 500;
          color: #64748b;
          margin-bottom: 6px;
        }

        .custom-multiselect-trigger {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 10px 14px;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 10px;
          cursor: pointer;
          transition: all 0.2s ease;
          min-height: 44px;
        }

        .custom-multiselect-trigger:hover {
          border-color: #cbd5e1;
        }

        .custom-multiselect-trigger.open {
          border-color: #308382;
          box-shadow: 0 0 0 3px rgba(48, 131, 130, 0.1);
        }

        .selected-value {
          font-size: 14px;
          color: #1e293b;
          font-weight: 500;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          max-width: 180px;
        }

        .placeholder {
          font-size: 14px;
          color: #94a3b8;
        }

        .custom-multiselect-arrow {
          color: #64748b;
          transition: transform 0.2s ease;
          flex-shrink: 0;
        }

        .custom-multiselect-arrow.rotated {
          transform: rotate(180deg);
        }

        .custom-multiselect-dropdown {
          position: absolute;
          top: calc(100% + 4px);
          left: 0;
          right: 0;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 10px;
          box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
          z-index: 100;
          max-height: 220px;
          overflow-y: auto;
          animation: multiDropdownFadeIn 0.15s ease;
        }

        @keyframes multiDropdownFadeIn {
          from {
            opacity: 0;
            transform: translateY(-8px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        .custom-multiselect-option {
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 10px 14px;
          font-size: 14px;
          color: #334155;
          cursor: pointer;
          transition: background 0.15s ease;
        }

        .custom-multiselect-option:first-child {
          border-radius: 10px 10px 0 0;
        }

        .custom-multiselect-option:last-child {
          border-radius: 0 0 10px 10px;
        }

        .custom-multiselect-option:hover {
          background: #f1f5f9;
        }

        .custom-multiselect-option.selected {
          background: rgba(48, 131, 130, 0.08);
        }

        .custom-multiselect-option.selected span {
          color: #308382;
          font-weight: 500;
        }

        .custom-checkbox {
          width: 18px;
          height: 18px;
          border: 2px solid #cbd5e1;
          border-radius: 4px;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: all 0.15s ease;
          flex-shrink: 0;
        }

        .custom-checkbox.checked {
          background: #308382;
          border-color: #308382;
          color: white;
        }

        .custom-multiselect-empty {
          padding: 12px 14px;
          font-size: 13px;
          color: #94a3b8;
          text-align: center;
        }
      `})]})},BYe=()=>s.jsxs(s.Fragment,{children:[s.jsx("div",{className:"simple-loader",children:s.jsx("div",{className:"loader-spinner"})}),s.jsx("style",{jsx:!0,children:`
