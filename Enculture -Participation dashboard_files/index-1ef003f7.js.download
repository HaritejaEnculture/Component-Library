        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        .dashboard-chart-card {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 252, 254, 0.95) 50%, rgba(248, 250, 252, 0.92) 100%);
          backdrop-filter: blur(32px) saturate(180%);
          border-radius: 18px;
          border: 1.5px solid rgba(255, 255, 255, 0.75);
          box-shadow: 
            0 12px 40px rgba(0, 0, 0, 0.08),
            0 6px 20px rgba(0, 0, 0, 0.06),
            0 2px 8px rgba(0, 0, 0, 0.04),
            inset 0 1.5px 0 rgba(255, 255, 255, 0.95),
            inset 0 -1px 0 rgba(0, 0, 0, 0.03);
          width: 100%;
          box-sizing: border-box;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          position: relative;
          overflow: hidden;
        }

        .dashboard-chart-card::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          border-radius: 18px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.15) 30%, transparent 60%, rgba(124, 58, 237, 0.03) 100%);
          pointer-events: none;
          opacity: 0.8;
          z-index: 0;
          transition: opacity 0.3s ease;
        }

        .dashboard-chart-card:hover {
          transform: translateY(-3px) scale(1.002);
          box-shadow: 
            0 16px 50px rgba(0, 0, 0, 0.11),
            0 8px 24px rgba(0, 0, 0, 0.08),
            0 3px 10px rgba(0, 0, 0, 0.05),
            inset 0 1.5px 0 rgba(255, 255, 255, 1),
            inset 0 -1px 0 rgba(0, 0, 0, 0.04);
          border-color: rgba(255, 255, 255, 0.9);
        }

        .dashboard-chart-card:hover::before {
          opacity: 1;
        }

        .dashboard-chart-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1rem 1.5rem;
          border-bottom: 1px solid rgba(226, 232, 240, 0.6);
          position: relative;
          z-index: 1;
        }

        .dashboard-chart-title-container {
          display: flex;
          align-items: center;
          gap: 0.5rem;
        }

        .dashboard-chart-title {
          font-size: 18px;
          font-weight: 700;
          color: #1e293b;
          margin: 0;
          letter-spacing: -0.3px;
          line-height: 1.3;
          font-family: 'Poppins', sans-serif;
          text-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .dashboard-chart-content {
          width: 100%;
          box-sizing: border-box;
          position: relative;
          z-index: 1;
        }

        .dashboard-chart-content.heatmap-padding {
          padding: 1rem;
        }

        .dashboard-chart-content.normal-padding {
          padding: 1rem 2rem;
        }
      `})]})},zYe=({label:e,placeholder:t="Select",options:r=[],value:n,onChange:a})=>{const[i,o]=_.useState(!1),l=_.useRef(null);_.useEffect(()=>{const d=u=>{l.current&&!l.current.contains(u.target)&&o(!1)};return document.addEventListener("mousedown",d),()=>document.removeEventListener("mousedown",d)},[]);const c=r.find(d=>d.id===n);return s.jsxs(s.Fragment,{children:[s.jsxs("div",{className:"custom-select-wrapper",ref:l,children:[e&&s.jsx("label",{className:"custom-select-label",children:e}),s.jsxs("div",{className:`custom-select-trigger ${i?"open":""}`,onClick:()=>o(!i),children:[s.jsx("span",{className:c?"selected-value":"placeholder",children:(c==null?void 0:c.name)||t}),s.jsx(Ei,{className:`custom-select-arrow ${i?"rotated":""}`,size:18})]}),i&&s.jsx("div",{className:"custom-select-dropdown",children:r.length===0?s.jsx("div",{className:"custom-select-empty",children:"No options available"}):r.map(d=>s.jsxs("div",{className:`custom-select-option ${n===d.id?"selected":""}`,onClick:()=>{a(d.id),o(!1)},children:[d.name,n===d.id&&s.jsx(q0,{size:16,className:"check-icon"})]},d.id))})]}),s.jsx("style",{jsx:!0,children:`
        .custom-select-wrapper {
          position: relative;
          min-width: 180px;
          font-family: 'Poppins', sans-serif;
        }

        .custom-select-label {
          display: block;
          font-size: 12px;
          font-weight: 500;
          color: #64748b;
          margin-bottom: 6px;
        }

        .custom-select-trigger {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 10px 14px;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 10px;
          cursor: pointer;
          transition: all 0.2s ease;
          min-height: 44px;
        }

        .custom-select-trigger:hover {
          border-color: #cbd5e1;
        }

        .custom-select-trigger.open {
          border-color: #308382;
          box-shadow: 0 0 0 3px rgba(48, 131, 130, 0.1);
        }

        .selected-value {
          font-size: 14px;
          color: #1e293b;
          font-weight: 500;
        }

        .placeholder {
          font-size: 14px;
          color: #94a3b8;
        }

        .custom-select-arrow {
          color: #64748b;
          transition: transform 0.2s ease;
          flex-shrink: 0;
        }

        .custom-select-arrow.rotated {
          transform: rotate(180deg);
        }

        .custom-select-dropdown {
          position: absolute;
          top: calc(100% + 4px);
          left: 0;
          right: 0;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 10px;
          box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
          z-index: 100;
          max-height: 220px;
          overflow-y: auto;
