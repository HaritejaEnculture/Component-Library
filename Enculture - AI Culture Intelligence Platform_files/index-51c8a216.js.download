        .insights-card-footer {
          display: flex;
          align-items: center;
          justify-content: center;
          margin-top: auto;
          padding-top: 8px;
          border-top: 1px solid rgba(226, 232, 240, 0.4);
        }

        .insights-footer-text {
          font-size: 10px;
          color: #64748b;
          font-family: 'Poppins', sans-serif;
          font-weight: 500;
          text-align: center;
          line-height: 1.4;
          /* Prevent text stretching */
          word-wrap: break-word;
          overflow-wrap: break-word;
          max-width: 100%;
        }
