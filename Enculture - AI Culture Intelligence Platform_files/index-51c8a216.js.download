        .modal-backdrop-add {
          position: fixed;
          inset: 0;
          background: rgba(0, 0, 0, 0.6);
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10000;
          backdrop-filter: blur(4px);
          padding: 20px;
          animation: fadeIn 0.2s ease;
        }
        
        @keyframes fadeIn {
          from { opacity: 0; }
          to { opacity: 1; }
        }
        
        .add-modal {
          background: #ffffff;
          border-radius: 20px;
          box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
          max-width: 700px;
          width: 100%;
          max-height: 90vh;
          display: flex;
          flex-direction: column;
          animation: slideUp 0.3s ease;
          overflow: hidden;
        }
        
        @keyframes slideUp {
          from {
            opacity: 0;
            transform: translateY(20px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
        
        .add-modal-header {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          padding: 24px 28px;
          border-bottom: 1px solid rgba(139, 92, 246, 0.15);
        }
        
        .header-text h2 {
          margin: 0;
          font-size: 22px;
          font-weight: 600;
          color: #1f2937;
          font-family: 'Poppins', sans-serif;
        }
        
        .header-text p {
          margin: 4px 0 0 0;
          font-size: 13px;
          color: #6b7280;
          font-family: 'Poppins', sans-serif;
        }
        
        .close-button {
          background: transparent;
          border: none;
          color: #6b7280;
          cursor: pointer;
          padding: 4px;
          border-radius: 4px;
          transition: all 0.2s ease;
          flex-shrink: 0;
        }
        
        .close-button:hover {
          background: rgba(139, 92, 246, 0.1);
          color: #8b5cf6;
        }
        
        .add-modal-form {
          padding: 24px 28px;
          overflow-y: auto;
          flex: 1;
        }
        
        .form-group {
          margin-bottom: 20px;
        }
        
        .form-row {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 16px;
        }
        
        .form-label {
          display: block;
          margin-bottom: 8px;
          font-size: 13px;
          font-weight: 500;
          color: #374151;
          font-family: 'Poppins', sans-serif;
        }
        
        .required {
          color: #dc2626;
        }
        
        .form-input,
        .form-textarea,
        .form-select {
          width: 100%;
          padding: 10px 12px;
          border: 1px solid #d1d5db;
          border-radius: 8px;
          font-size: 14px;
          font-family: 'Poppins', sans-serif;
          color: #1f2937;
          transition: all 0.2s ease;
          box-sizing: border-box;
        }
        
        .form-input:focus,
        .form-textarea:focus,
        .form-select:focus {
          outline: none;
          border-color: #8b5cf6;
          box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
        }
        
        .form-input.error,
        .form-textarea.error {
          border-color: #dc2626;
        }
        
        .form-textarea {
          resize: vertical;
          min-height: 80px;
        }
        
        .error-text {
          display: block;
          margin-top: 6px;
          font-size: 12px;
          color: #dc2626;
          font-family: 'Poppins', sans-serif;
        }
        
        .char-count {
          display: block;
          margin-top: 6px;
          font-size: 12px;
          color: #9ca3af;
          text-align: right;
          font-family: 'Poppins', sans-serif;
        }
        
        .submit-error {
          margin-bottom: 20px;
          padding: 12px;
          background: rgba(220, 38, 38, 0.1);
          border: 1px solid rgba(220, 38, 38, 0.2);
          border-radius: 8px;
          color: #dc2626;
          font-size: 14px;
          font-family: 'Poppins', sans-serif;
        }
        
        .add-modal-footer {
          display: flex;
          justify-content: flex-end;
          gap: 12px;
          padding: 20px 28px;
          border-top: 1px solid rgba(139, 92, 246, 0.15);
        }
        
        .cancel-button,
        .submit-button {
          padding: 10px 20px;
          border-radius: 8px;
          font-size: 14px;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.2s ease;
          font-family: 'Poppins', sans-serif;
          display: flex;
          align-items: center;
          gap: 6px;
        }
        
        .cancel-button {
          background: transparent;
          border: 1px solid #d1d5db;
          color: #6b7280;
        }
        
        .cancel-button:hover:not(:disabled) {
          background: #f9fafb;
          border-color: #9ca3af;
        }
        
        .submit-button {
          background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
          border: none;
          color: #ffffff;
        }
        
        .submit-button:hover:not(:disabled) {
          background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
          box-shadow: 0 4px 12px rgba(139, 92, 246, 0.4);
        }
        
        .cancel-button:disabled,
        .submit-button:disabled {
          opacity: 0.5;
          cursor: not-allowed;
        }
        
        @media (max-width: 768px) {
          .add-modal {
            max-width: 100%;
            max-height: 95vh;
          }
          
          .form-row {
            grid-template-columns: 1fr;
          }
          
          .add-modal-header,
          .add-modal-form,
          .add-modal-footer {
            padding-left: 20px;
            padding-right: 20px;
          }
        }
      `})]})};function QAt(){const e=fi(),t=Li(),{activePersona:r,switchPersona:n}=gg();k.useEffect(()=>{const be="actionsDefaultPersona",ae=localStorage.getItem(be);ae?ae!==r&&n(ae):(n("My Actions"),localStorage.setItem(be,"My Actions"))},[]),k.useEffect(()=>{const be="actionsDefaultPersona";r&&localStorage.setItem(be,r)},[r]);const{actions:a,groupedActions:i,allActions:s,selectedAction:l,stats:c,loading:d,error:u,searchQuery:p,sortBy:f,filters:h,groupBy:g,updateActionStatus:m,updateAction:v,createAction:x,deleteAction:y,toggleFavorite:b,assignAction:w,fetchActions:S,setSearchQuery:C,setSortBy:j,setGroupBy:A,updateFilter:_,resetFilters:N,selectAction:T,deselectAction:E}=Xkt(r),[I,P]=k.useState(!1),[M,D]=k.useState(()=>localStorage.getItem("actionsViewMode")||"list"),z=be=>{D(be),localStorage.setItem("actionsViewMode",be)};k.useEffect(()=>{const be=new URLSearchParams(t.search),ae=be.get("actionId"),ce=be.get("openModal");!ae&&!ce&&(E(),t.search&&(console.log("🧹 Clearing URL params on persona change"),e("/actions",{replace:!0})))},[r]),k.useEffect(()=>{const be=new URLSearchParams(t.search),ae=be.get("actionId"),ce=be.get("openModal");if(console.log("🔍 Actions URL params:",{actionId:ae,openModal:ce,actionsLoaded:s.length,loading:d}),ae&&ce==="true"){if(d){console.log("⏳ Waiting for actions to load...");return}if(s.length>0){const Ae=s.find(X=>X.id===ae);Ae?(console.log("✅ Found action, opening detail modal:",Ae.title),T(Ae)):console.log("❌ Action not found:",ae,"Available:",s.map(X=>X.id))}}},[t.search,s,d,T]);const L=be=>{T(be)},U=()=>{E(),t.search&&e("/actions",{replace:!0})},R=async(be,ae)=>{await b(be,ae),l&&l.id===be&&T({...l,isFavorited:!ae})},F=async(be,ae)=>{await m(be,ae)},V=async(be,ae)=>{await m(be,ae)},$=be=>{!be||!be.cardId||(console.log("🚀 Navigating to source:",{cardId:be.cardId,cardName:be.cardName,sourcePersona:be.persona}),e(`/insights?cardId=${be.cardId}&modalId=${be.cardId}&openModal=true&sourcePersona=${be.persona}`,{state:{openCardModal:be.card