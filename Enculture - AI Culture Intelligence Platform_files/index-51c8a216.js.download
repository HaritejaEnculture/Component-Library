        .insights-card {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 252, 254, 0.95) 50%, rgba(248, 250, 252, 0.92) 100%);
          backdrop-filter: blur(32px) saturate(180%);
          border-radius: 18px;
          padding: 26px;
          box-shadow: 
            0 12px 40px rgba(0, 0, 0, 0.08),
            0 6px 20px rgba(0, 0, 0, 0.06),
            0 2px 8px rgba(0, 0, 0, 0.04),
            inset 0 1.5px 0 rgba(255, 255, 255, 0.95),
            inset 0 -1px 0 rgba(0, 0, 0, 0.03);
          border: 1.5px solid rgba(255, 255, 255, 0.75);
          position: relative;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          display: flex;
          flex-direction: column;
          height: 100%;
          min-height: 290px;
          box-sizing: border-box;
          min-width: 0;
          overflow: hidden;
        }

        .insights-card::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          border-radius: 18px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.15) 30%, transparent 60%, rgba(124, 58, 237, 0.03) 100%);
          pointer-events: none;
          opacity: 0.8;
          z-index: 0;
          transition: opacity 0.3s ease;
        }

        .insights-card > * {
          position: relative;
          z-index: 1;
        }

        .insights-card:hover {
          transform: translateY(-3px) scale(1.005);
          box-shadow: 
            0 16px 50px rgba(0, 0, 0, 0.11),
            0 8px 24px rgba(0, 0, 0, 0.08),
            0 3px 10px rgba(0, 0, 0, 0.05),
            inset 0 1.5px 0 rgba(255, 255, 255, 1),
            inset 0 -1px 0 rgba(0, 0, 0, 0.04);
          border-color: rgba(255, 255, 255, 0.9);
        }

        .insights-card:hover::before {
          opacity: 1;
        }

        .insights-card-skeleton {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.85) 0%, rgba(248, 250, 252, 0.8) 100%);
          backdrop-filter: blur(24px);
          border-radius: 16px;
          padding: 24px;
          border: 1px solid rgba(255, 255, 255, 0.6);
          box-shadow: 
            0 8px 32px rgba(0, 0, 0, 0.06),
            0 4px 16px rgba(0, 0, 0, 0.04),
            inset 0 1px 0 rgba(255, 255, 255, 0.8),
            inset 0 -1px 0 rgba(0, 0, 0, 0.02);
          position: relative;
          animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
          box-sizing: border-box;
        }

        .insights-card-skeleton::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          border-radius: 16px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, transparent 50%, rgba(255, 255, 255, 0.1) 100%);
          pointer-events: none;
          opacity: 0.7;
          z-index: 0;
        }

        .insights-card-skeleton > * {
          position: relative;
          z-index: 1;
        }

        @keyframes pulse {
          0%, 100% {
            opacity: 1;
          }
          50% {
            opacity: 0.5;
          }
        }

        .insights-cta-btn {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          width: auto;
          padding: 13px 18px;
          background: linear-gradient(135deg, #3F205F 0%, #4A2A6F 50%, #3F205F 100%);
          border: none;
          border-radius: 14px;
          font-size: 14px;
          font-weight: 700;
          color: #ffffff;
          font-family: 'Poppins', sans-serif;
          text-transform: uppercase;
          letter-spacing: 0.6px;
          cursor: pointer;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          box-shadow: 0 6px 16px rgba(63, 32, 95, 0.3), 0 2px 6px rgba(63, 32, 95, 0.2);
          margin: 0 auto;
          position: relative;
          overflow: hidden;
        }

        .insights-cta-btn::before {
          content: '';
          position: absolute;
          top: 0;
          left: -100%;
          width: 100%;
          height: 100%;
          background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
          transition: left 0.5s ease;
        }

        .insights-cta-btn:hover::before {
          left: 100%;
        }

        .insights-cta-btn:hover {
          background: linear-gradient(135deg, #4A2A6F 0%, #5A3A7F 50%, #4A2A6F 100%);
          transform: translateY(-2px) scale(1.02);
          box-shadow: 0 8px 20px rgba(63, 32, 95, 0.4), 0 4px 10px rgba(63, 32, 95, 0.3);
        }

        .insights-cta-btn:active {
          transform: translateY(0) scale(1);
          box-shadow: 0 3px 10px rgba(63, 32, 95, 0.3), 0 1px 4px rgba(63, 32, 95, 0.2);
        }

        .insights-cta-btn :global(svg) {
          color: #ffffff;
        }

        .insight-banner {
          width: calc(100% + 48px);
          height: 40px;
          border-radius: 16px 16px 0 0;
          display: flex;
          align-items: center;
          gap: 12px;
          padding-left: 12px;
          margin: -24px -24px 12px -24px;
        }

        .insight-icon-container {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 24px;
          height: 24px;
          flex-shrink: 0;
        }

        .insight-label {
          font-size: 12px;
          font-weight: 600;
          white-space: nowrap;
        }
      `})]})},cqe=({summaryCards:e})=>o.jsx(lqe,{summaryCards:e}),dqe=({size:e=16,color:t="#2B2D2E",...r})=>o.jsxs("svg",{xmlns:"http://www.w3.org/2000/svg",width:e,height:e,viewBox:"0 0 16 16",fill:"none",...r,children:[o.jsx("path",{d:"M6 6.99999C5.93442 7.00079 5.86941 6.98786 5.80913 6.96202C5.74885 6.93619 5.69465 6.89803 5.65 6.84999L1.15 2.34999C0.95 2.14999 0.95 1.83999 1.15 1.63999C1.35 1.43999 1.66 1.43999 1.86 1.63999L6.35 6.14999C6.55 6.34999 6.55 6.65999 6.35 6.85999C6.25 6.95999 6.12 7.00999 6 7.00999V6.99999ZM1.56 14.44C1.49442 14.4408 1.42941 14.4279 1.36913 14.402C1.30885 14.3762 1.25465 14.338 1.21 14.29C1.01 14.09 1.01 13.78 1.21 13.58L5.65 9.13999C5.85 8.93999 6.16 8.93999 6.36 9.13999C6.56 9.33999 6.56 9.64999 6.36 9.84999L1.92 14.29C1.82 14.39 1.69 14.44 1.57 14.44H1.56ZM14.31 14.31C14.2444 14.3108 14.1794 14.2979 14.1191 14.272C14.0589 14.2462 14.0046 14.208 13.96 14.16L9.65 9.84999C9.45 9.64999 9.45 9.33999 9.65 9.13999C9.85 8.93999 10.16 8.93999 10.36 9.13999L14.67 13.45C14.87 13.65 14.87 13.96 14.67 14.16C14.57 14.26 14.44 14.31 14.32 14.31H14.31Z",fill:t}),o.jsx("path",{d:"M1 6.33C0.72 6.33 0.5 6.11 0.5 5.83V2.5C0.5 1.67 1.17 1 2 1H5.67C5.95 1 6.17 1.22 6.17 1.5C6.17 1.78 5.95 2 5.67 2H2C1.72 2 1.5 2.22 1.5 2.5V5.83C1.5 6.11 1.28 6.33 1 6.33ZM5.33 15H2C1.17 15 0.5 14.33 0.5 13.5V9.83C0.5 9.55 0.72 9.33 1 9.33C1.28 9.33 1.5 9.55 1.5 9.83V13.5C1.5 13.78 1.72 14 2 14H5.33C5.61 14 5.83 14.22 5.83 14.5C5.83 14.78 5.61 15 5.33 15ZM14 15H10.33C10.05 15 9.83 14.78 9.83 14.5C9.83 14.22 10.05 14 10.33 14H14C14.28 14 14.5 13.78 14.5 13.5V10.17C14.5 9.89 14.72 9.67 15 9.67C15.28 9.67 15.5 9.89 15.5 10.17V13.5C15.5 14.33 14.83 15 14 15ZM15 6.67C14.72 6.67 14.5 6.45 14.5 6.17V2.5C14.5 2.22 14.28 2 14 2H10.67C10.39 2 10.17 1.78 10.17 1.5C10.17 1.22 10.39 1 10.67 1H14C14.83 1 15.5 1.67 15.5 2.5V6.17C15.5 6.45 15.28 6.67 15 6.67Z",fill:t}),o.jsx("path",{d:"M10 7C9.93442 7.0008 9.86941 6.98787 9.80913 6.96203C9.74885 6.9362 9.69465 6.89804 9.65 6.85C9.45 6.