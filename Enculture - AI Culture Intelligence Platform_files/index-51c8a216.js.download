        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        .insights-modal-dropdown {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 250, 252, 0.95) 100%);
          backdrop-filter: blur(24px);
          border-radius: 16px;
          box-shadow: 
            0 20px 60px rgba(0, 0, 0, 0.15),
            0 8px 32px rgba(0, 0, 0, 0.1);
          border: 1px solid rgba(255, 255, 255, 0.8);
          display: flex;
          flex-direction: column;
          overflow: hidden;
          font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        }

        .insights-search-input {
          width: 100%;
          padding: 0.5rem 2.5rem 0.5rem 2.5rem;
          border: 1px solid rgba(226, 232, 240, 0.6);
          border-radius: 8px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%);
          backdrop-filter: blur(10px);
          font-size: 0.875rem;
          color: #1e293b;
          font-family: 'Poppins', sans-serif;
          transition: all 0.3s ease;
          position: relative;
          z-index: 0;
        }

        .insights-search-input:focus {
          outline: none;
          border-color: rgba(196, 181, 253, 0.5);
          box-shadow: 0 0 0 3px rgba(196, 181, 253, 0.1);
          background: rgba(255, 255, 255, 0.95);
        }

        .insights-search-input::placeholder {
          color: #94a3b8;
        }

        .insights-modal-option {
          width: 100%;
          padding: 0.75rem 1rem;
          border: 1px solid rgba(226, 232, 240, 0.4);
          border-radius: 8px;
          background: transparent;
          cursor: pointer;
          text-align: left;
          display: flex;
          align-items: center;
          transition: all 0.3s ease;
          font-family: 'Poppins', sans-serif;
          font-size: 0.875rem;
          font-weight: 400;
          color: #1e293b;
          line-height: 1.5;
        }

        .insights-modal-option:hover {
          background: linear-gradient(135deg, rgba(248, 250, 252, 0.8) 0%, rgba(241, 245, 249, 0.7) 100%);
          border-color: rgba(196, 181, 253, 0.3);
          transform: translateX(2px);
        }

        .insights-modal-option.active {
          background: linear-gradient(135deg, rgba(224, 231, 255, 0.5) 0%, rgba(241, 245, 249, 0.6) 100%);
          border-color: rgba(196, 181, 253, 0.4);
        }

        .insights-modal-option span {
          font-family: 'Poppins', sans-serif;
        }

        .insights-modal-overlay {
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 50;
          background: rgba(0, 0, 0, 0.3);
          backdrop-filter: blur(4px);
        }

        .insights-modal-header-section {
          padding: 0.5rem 1rem;
          border-bottom: 1px dashed rgba(196, 181, 253, 0.4);
          margin-bottom: 8px;
        }

        .insights-modal-header-section h3 {
          font-size: 0.875rem;
          font-weight: 500;
          color: #475569;
          font-family: 'Poppins', sans-serif;
          margin: 0;
        }

        .insights-modal-divider {
          border-bottom: 1px dashed rgba(196, 181, 253, 0.3);
          height: 1px;
          margin-top: 8px;
          margin-bottom: 0;
          width: 100%;
        }

        .insights-modal-divider-large {
          border-bottom: 1px dashed rgba(196, 181, 253, 0.3);
          height: 1px;
          margin-top: 16px;
          margin-bottom: 16px;
          width: 100%;
        }
      `})]})},kqe="https://3wnyu6icoi.execute-api.ap-southeast-1.amazonaws.com/dev/",Nqe={}.VITE_RESULT_SERVICE_URL||"https://71ugi272i2.execute-api.ap-southeast-1.amazonaws.com/dev/";let xS="https://91p7druazj.execute-api.ap-southeast-1.amazonaws.com/dev/";xS=xS.replace(/\/$/,"");xS=xS.replace(/\/api\/v1$/,"");const Aqe="https://z8jusb1ycl.execute-api.ap-southeast-1.amazonaws.com/dev/",fme="https://n7dwaxizs7.execute-api.ap-southeast-1.amazonaws.com/dev/";console.log("SURVEY_CORE_SERVICE_URL:",fme);const Tqe="https://ybkmqebajj.execute-api.ap-southeast-1.amazonaws.com/dev/",Eqe="https://41q00nanzf.execute-api.ap-southeast-1.amazonaws.com/dev/",Iqe="https://ti0rfhpnle.execute-api.ap-southeast-1.amazonaws.com/dev/",Dqe="https://en8tjhnptj.execute-api.ap-southeast-1.amazonaws.com/dev/",Mqe="https://ilakwkvf35.execute-api.ap-southeast-1.amazonaws.com/dev/",Pqe="https://kv6asxe8me.execute-api.ap-southeast-1.amazonaws.com/dev/",Qd=e=>{const t=Ma.create({baseURL:e,headers:{"Content-Type":"application/json"}});return t.interceptors.request.use(r=>{const n=localStorage.getItem("token")||localStorage.getItem("accessToken"),a=localStorage.getItem("tenantToken");return n&&(r.headers.Authorization=`Bearer ${n}`),a&&(r.headers["x-tenant-token"]=a),r}),t},ti=Qd(kqe),op=Qd(xS),gu=Qd(Aqe),wc=Qd(fme),sp=Qd(Tqe),du=Qd(Eqe),Y3=Qd(Nqe),lp=Qd(Iqe),Vo=Qd(Dqe),Rqe=Qd(Mqe),Oqe=Qd(Pqe),cv=e=>{const{search:t="",sortBy:r="createdAt",sortOrder:n="desc",page:a=1,limit:i=10,payloadForDashboardFilters:s=[]}=e,l=Array.isArray(s)&&s.length===0?"[]":JSON.stringify(s);return{search:t||"",sortBy:r||"createdAt",sortOrder:n||"desc",page:a.toString(),limit:i.toString(),payloadForDashboardFilters:l}},ps={getSurveyData:async()=>(await wc.get("/survey-data")).data,createSurveyMetadata:async e=>(await wc.post("/survey-metadata",e)).data,updateSurveyMetadata:async(e,t)=>(await wc.patch(`/survey-metadata/${e}`,t)).data,updateSurveyMapping:async(e,t)=>(await wc.patch(`/survey-mapping/${e}`,t)).data,getSurveyByI