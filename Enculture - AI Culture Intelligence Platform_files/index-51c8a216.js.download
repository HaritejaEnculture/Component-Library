        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        .dashboard-chart-card {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 252, 254, 0.95) 50%, rgba(248, 250, 252, 0.92) 100%);
          backdrop-filter: blur(32px) saturate(180%);
          border-radius: 18px;
          border: 1.5px solid rgba(255, 255, 255, 0.75);
          box-shadow: 
            0 12px 40px rgba(0, 0, 0, 0.08),
            0 6px 20px rgba(0, 0, 0, 0.06),
            0 2px 8px rgba(0, 0, 0, 0.04),
            inset 0 1.5px 0 rgba(255, 255, 255, 0.95),
            inset 0 -1px 0 rgba(0, 0, 0, 0.03);
          width: 100%;
          box-sizing: border-box;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          position: relative;
          overflow: hidden;
        }

        .dashboard-chart-card::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          border-radius: 18px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.15) 30%, transparent 60%, rgba(124, 58, 237, 0.03) 100%);
          pointer-events: none;
          opacity: 0.8;
          z-index: 0;
          transition: opacity 0.3s ease;
        }

        .dashboard-chart-card:hover {
          transform: translateY(-3px) scale(1.002);
          box-shadow: 
            0 16px 50px rgba(0, 0, 0, 0.11),
            0 8px 24px rgba(0, 0, 0, 0.08),
            0 3px 10px rgba(0, 0, 0, 0.05),
            inset 0 1.5px 0 rgba(255, 255, 255, 1),
            inset 0 -1px 0 rgba(0, 0, 0, 0.04);
          border-color: rgba(255, 255, 255, 0.9);
        }

        .dashboard-chart-card:hover::before {
          opacity: 1;
        }

        .dashboard-chart-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1rem 1.5rem;
          border-bottom: 1px solid rgba(226, 232, 240, 0.6);
          position: relative;
          z-index: 1;
        }

        .dashboard-chart-title-container {
          display: flex;
          align-items: center;
          gap: 0.5rem;
        }

        .dashboard-chart-title {
          font-size: 18px;
          font-weight: 700;
          color: #1e293b;
          margin: 0;
          letter-spacing: -0.3px;
          line-height: 1.3;
          font-family: 'Poppins', sans-serif;
          text-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .dashboard-chart-content {
          width: 100%;
          box-sizing: border-box;
          position: relative;
          z-index: 1;
        }

        .dashboard-chart-content.heatmap-padding {
          padding: 1rem;
        }

        .dashboard-chart-content.normal-padding {
          padding: 1rem 2rem;
        }
      `})]})},fqe=({label:e,placeholder:t="Select",options:r=[],value:n,onChange:a})=>{const[i,s]=k.useState(!1),l=k.useRef(null);k.useEffect(()=>{const d=u=>{l.current&&!l.current.contains(u.target)&&s(!1)};return document.addEventListener("mousedown",d),()=>document.removeEventListener("mousedown",d)},[]);const c=r.find(d=>d.id===n);return o.jsxs(o.Fragment,{children:[o.jsxs("div",{className:"custom-select-wrapper",ref:l,children:[e&&o.jsx("label",{className:"custom-select-label",children:e}),o.jsxs("div",{className:`custom-select-trigger ${i?"open":""}`,onClick:()=>s(!i),children:[o.jsx("span",{className:c?"selected-value":"placeholder",children:(c==null?void 0:c.name)||t}),o.jsx(Ea,{className:`custom-select-arrow ${i?"rotated":""}`,size:18})]}),i&&o.jsx("div",{className:"custom-select-dropdown",children:r.length===0?o.jsx("div",{className:"custom-select-empty",children:"No options available"}):r.map(d=>o.jsxs("div",{className:`custom-select-option ${n===d.id?"selected":""}`,onClick:()=>{a(d.id),s(!1)},children:[d.name,n===d.id&&o.jsx(N0,{size:16,className:"check-icon"})]},d.id))})]}),o.jsx("style",{jsx:!0,children:`
        .custom-select-wrapper {
          position: relative;
          min-width: 180px;
          font-family: 'Poppins', sans-serif;
        }

        .custom-select-label {
          display: block;
          font-size: 12px;
          font-weight: 500;
          color: #64748b;
          margin-bottom: 6px;
        }

        .custom-select-trigger {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 10px 14px;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 10px;
          cursor: pointer;
          transition: all 0.2s ease;
          min-height: 44px;
        }

        .custom-select-trigger:hover {
          border-color: #cbd5e1;
        }

        .custom-select-trigger.open {
          border-color: #308382;
          box-shadow: 0 0 0 3px rgba(48, 131, 130, 0.1);
        }

        .selected-value {
          font-size: 14px;
          color: #1e293b;
          font-weight: 500;
        }

        .placeholder {
          font-size: 14px;
          color: #94a3b8;
        }

        .custom-select-arrow {
          color: #64748b;
          transition: transform 0.2s ease;
          flex-shrink: 0;
        }

        .custom-select-arrow.rotated {
          transform: rotate(180deg);
        }

        .custom-select-dropdown {
          position: absolute;
          top: calc(100% + 4px);
          left: 0;
          right: 0;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 10px;
          box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
          z-index: 100;
          max-height: 220px;
          overflow-y: auto;
          animation: dropdownFadeIn 0.15s ease;
        }

        @keyframes dropdownFadeIn {
          from {
            opacity: 0;
            transform: translateY(-8px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        .custom-select-option {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 10px 14px;
          font-size: 14px;
          color: #334155;
          cursor: pointer;
          transition: background 0.15s ease;
        }

        .custom-select-option:first-child {
          border-radius: 10px 10px 0 0;
        }

        .custom-select-option:last-child {
          border-radius: 0 0 10px 10px;
        }

        .custom-select-option:hover {
          background: #f1f5f9;
        }

        .custom-select-option.selected {
          background: rgba(48, 131, 130, 0.08);
          color: #308382;
          font-weight: 500;
        }

        .custom-select-option .check-icon {
          color: #308382;
        }

        .custom-select-empty {
          padding: 12px 14px;
          font-size: 13px;
          color: #94a3b8;
          text-align: center;
        }
      `})]})},hqe=({label:e,placeholder:t="Select",options:r=[],value:n=[],onChange:a,maxSelected:i=2})=>{const[s,l]=k.useState(!1),c=k.useRef(null);k.useEffect(()=>{const f=h=>{c.current&&!c.current.contains(h.target)&&l(!1)};return document.addEventListener("mousedown",f),()=>document.removeEventListener("mousedown",f)},[]);const d=r.filter(f=>n.includes(f.id)),u=d.length>0?d.map(f=>f.name).join(", "):t,p=f=>{let h;n.includes(f)?h=n.filter(g=>g!==f):n.length>=i?h=[...n.slice(1),f]:h=[...n,f],a(h)};return o.jsxs(o.Fragment,{children:[o.jsxs("div",{className:"custom-multiselect-wrapper",ref:c,children:[e&&o.jsx("label",{className:"custom-multiselect-label",children:e}),o.jsxs("div",{className:`custom-multiselect-trigger ${s?"open":""}`,onClick:()=>l(!s),children:[o.jsx("span",{className:d.length>0?"selected-value":"placeholder",children:u}),o.jsx(Ea,{className:`custom-multiselect-arrow ${s?"rotated":""}`,size:18})]}),s&&o.jsx("div",{className:"custom-multiselect-dropdown",children:r.length===0?o.jsx("div",{className:"custom-multiselect-empty",children:"No options available"}):r.map(f=>o.jsxs("div",{className:`custom-multiselect-option ${n.includes(f.id)?"selected":""}`,onClick:()=>p(f.id),children:[o.jsx("div",{className:`custom-checkbox ${n.includes(f.id)?"checked":""}`,children:n.includes(f.id)&&o.jsx(N0,{size:12})}),o.jsx("span",{children:f.name})]},f.id))})]}),o.jsx("style",{jsx:!0,children:`
        .custom-multiselect-wrapper {
          position: relative;
          min-width: 220px;
          font-family: 'Poppins', sans-serif;
        }

        .custom-multiselect-label {
          display: block;
          font-size: 12px;
          font-weight: 500;
          color: #64748b;
          margin-bottom: 6px;
        }

        .custom-multiselect-trigger {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 10px 14px;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 10px;
          cursor: pointer;
          transition: all 0.2s ease;
          min-height: 44px;
        }

        .custom-multiselect-trigger:hover {
          border-color: #cbd5e1;
        }

        .custom-multiselect-trigger.open {
          border-color: #308382;
          box-shadow: 0 0 0 3px rgba(48, 131, 130, 0.1);
        }

        .selected-value {
          font-size: 14px;
          color: #1e293b;
          font-weight: 500;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          max-width: 180px;
        }

        .placeholder {
          font-size: 14px;
          color: #94a3b8;
        }

        .custom-multiselect-arrow {
          color: #64748b;
          transition: transform 0.2s ease;
          flex-shrink: 0;
        }

        .custom-multiselect-arrow.rotated {
          transform: rotate(180deg);
        }

        .custom-multiselect-dropdown {
          position: absolute;
          top: calc(100% + 4px);
          left: 0;
          right: 0;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 10px;
          box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
          z-index: 100;
          max-height: 220px;
          overflow-y: auto;
          animation: multiDropdownFadeIn 0.15s ease;
        }

        @keyframes multiDropdownFadeIn {
          from {
            opacity: 0;
            transform: translateY(-8px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        .custom-multiselect-option {
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 10px 14px;
          font-size: 14px;
          color: #334155;
          cursor: pointer;
          transition: background 0.15s ease;
        }

        .custom-multiselect-option:first-child {
          border-radius: 10px 10px 0 0;
        }

        .custom-multiselect-option:last-child {
          border-radius: 0 0 10px 10px;
        }

        .custom-multiselect-option:hover {
          background: #f1f5f9;
        }

        .custom-multiselect-option.selected {
          background: rgba(48, 131, 130, 0.08);
        }

        .custom-multiselect-option.selected span {
          color: #308382;
          font-weight: 500;
        }

        .custom-checkbox {
          width: 18px;
          height: 18px;
          border: 2px solid #cbd5e1;
          border-radius: 4px;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: all 0.15s ease;
          flex-shrink: 0;
        }

        .custom-checkbox.checked {
          background: #308382;
          border-color: #308382;
          color: white;
        }

        .custom-multiselect-empty {
          padding: 12px 14px;
          font-size: 13px;
          color: #94a3b8;
          text-align: center;
        }
      `})]})},gqe=()=>o.jsxs(o.Fragment,{children:[o.jsx("div",{className:"simple-loader",children:o.jsx("div",{className:"loader-spinner"})}),o.jsx("style",{jsx:!0,children:`
      .simple-loader {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem;
      }

      .loader-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #e2e8f0;
        border-top-color: #308382;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
    `})]}),n9=({icon:e,mainMessage:t,subMessage:r})=>o.jsxs(o.Fragment,{children:[o.jsx("div",{className:"dashboard-empty-card",children:o.jsxs("div",{className:"dashboard-empty-content",children:[o.jsx("div",{className:"dashboard-empty-icon",children:e}),o.jsxs("div",{className:"dashboard-empty-text",children:[o.jsx("div",{className:"dashboard-empty-title",children:t}),r&&o.jsx("div",{className:"dashboard-empty-subtitle",children:r})]})]})}),o.jsx("style",{jsx:!0,children:`
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        .dashboard-empty-card {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 252, 254, 0.95) 50%, rgba(248, 250, 252, 0.92) 100%);
          backdrop-filter: blur(32px) saturate(180%);
          border-radius: 18px;
          border: 1.5px solid rgba(255, 255, 255, 0.75);
          box-shadow: 
            0 12px 40px rgba(0, 0, 0, 0.08),
            0 6px 20px rgba(0, 0, 0, 0.06),
