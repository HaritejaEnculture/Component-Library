          .modal-backdrop-rich {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            padding: 20px;
            backdrop-filter: blur(8px);
            animation: fadeIn 0.2s ease;
          }
          
          @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
          }
          
          .action-detail-modal-rich {
            background: white;
            border-radius: 24px;
            max-width: 800px;
            width: 100%;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
            animation: slideUp 0.3s ease;
            overflow: hidden;
            border: 1px solid rgba(226, 232, 240, 0.6);
          }
          
          @keyframes slideUp {
            from {
              opacity: 0;
              transform: translateY(30px) scale(0.95);
            }
            to {
              opacity: 1;
              transform: translateY(0) scale(1);
            }
          }
          
          .modal-header-rich {
            padding: 28px 32px 20px 32px;
            border-bottom: 1px solid rgba(226, 232, 240, 0.6);
            background: rgba(249, 250, 251, 0.5);
          }
          
          .header-content-rich {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
          }
          
          .priority-section-rich {
            display: flex;
            align-items: center;
            gap: 8px;
          }
          
          .priority-badge-rich {
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-family: 'Poppins', sans-serif;
          }
          
          .priority-badge-rich.critical {
            background: linear-gradient(135deg, #450a0a 0%, #7f1d1d 100%);
            color: #fef2f2;
            box-shadow: 0 0 12px rgba(127, 29, 29, 0.4);
          }
          
          .priority-badge-rich.high {
            background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 100%);
            color: #fef2f2;
          }
          
          .priority-badge-rich.medium {
            background: linear-gradient(135deg, #92400e 0%, #b45309 100%);
            color: #fef3c7;
          }
          
          .priority-badge-rich.low {
            background: linear-gradient(135deg, #065f46 0%, #047857 100%);
            color: #ecfdf5;
          }
          
          .status-badge-rich {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
          }
          
          .status-badge-rich.pending {
            background: rgba(100, 116, 139, 0.15);
            color: #475569;
            border: 1.5px solid #64748b;
          }
          
          .status-badge-rich.in-progress {
            background: rgba(245, 158, 11, 0.15);
            color: #d97706;
            border: 1.5px solid #f59e0b;
          }
          
          .status-badge-rich.completed {
            background: rgba(16, 185, 129, 0.15);
            color: #059669;
            border: 1.5px solid #10b981;
          }
          
          .manual-badge-rich {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
            background: rgba(139, 92, 246, 0.2);
            color: #c4b5fd;
          }
          
          .close-btn-rich {
            background: rgba(0, 0, 0, 0.05);
            border: none;
            color: #64748b;
            cursor: pointer;
            padding: 8px;
            border-radius: 8px;
            transition: all 0.2s;
          }
          
          .close-btn-rich:hover {
            background: rgba(139, 92, 246, 0.1);
            color: #8B5CF6;
          }
          
          .progress-container-rich {
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
          }
          
          .progress-bar-rich {
            height: 100%;
            transition: width 0.3s ease;
            border-radius: 2px;
          }
          
          .modal-content-rich {
            flex: 1;
            overflow-y: auto;
            padding: 28px 32px;
          }
          
          .action-title-rich {
            font-family: 'Poppins', sans-serif;
            font-size: 28px;
            font-weight: 700;
            color: #1e293b;
            margin: 0 0 16px 0;
            line-height: 1.3;
          }
          
          .action-description-section-rich {
            margin-bottom: 28px;
            padding: 16px;
            background: rgba(249, 250, 251, 0.8);
            border: 1px solid rgba(226, 232, 240, 0.6);
            border-radius: 12px;
            transition: all 0.2s;
          }
          
          .action-description-section-rich:hover {
            background: rgba(139, 92, 246, 0.05);
            border-color: rgba(139, 92, 246, 0.3);
          }
          
          .action-description-section-rich h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 11px;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 8px 0;
          }
          
          .action-description-rich {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            font-weight: 600;
            color: #1e293b;
            line-height: 1.7;
            margin: 0;
          }
          
          .metadata-grid-rich {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
            margin-bottom: 28px;
          }
          
          .metadata-card-rich {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px;
            background: rgba(249, 250, 251, 0.8);
            border: 1px solid rgba(226, 232, 240, 0.6);
            border-radius: 12px;
            transition: all 0.2s;
          }
          
          .metadata-card-rich:hover {
            background: rgba(139, 92, 246, 0.05);
            border-color: rgba(139, 92, 246, 0.3);
          }
          
          .metadata-icon-rich {
            color: #8B5CF6;
            flex-shrink: 0;
          }
          
          .metadata-content-rich {
            display: flex;
            flex-direction: column;
            gap: 4px;
          }
          
          .metadata-label-rich {
            font-family: 'Poppins', sans-serif;
            font-size: 11px;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
          }
          
          .metadata-value-rich {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            font-weight: 600;
            font-weight: 600;
            color: #1e293b;
          }
          
          .timeline-section-rich,
          .source-section-rich,
          .notes-section-rich {
            margin-bottom: 24px;
          }
          
          .timeline-section-rich h4,
          .source-section-rich h4,
          .notes-section-rich h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 12px 0;
          }
          
          .timeline-items-rich {
            display: flex;
            flex-direction: column;
            gap: 8px;
          }
          
          .timeline-item-rich {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            color: #64748b;
          }
          
          .timeline-item-rich svg {
            color: #8B5CF6;
          }
          
          .source-card-rich {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            background: rgba(249, 250, 251, 0.8);
            border: 2px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s;
          }
          
          .source-card-rich:hover {
            background: rgba(139, 92, 246, 0.05);
            border-color: #8B5CF6;
            transform: translateX(4px);
          }
          
          .source-info-rich {
            display: flex;
            flex-direction: column;
            gap: 4px;
          }
          
          .source-name-rich {
            font-family: 'Poppins', sans-serif;
            font-size: 15px;
            font-weight: 600;
            color: #1e293b;
          }
          
          .source-desc-rich {
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            color: #94a3b8;
          }
          
          .source-icon-rich {
            color: #8B5CF6;
            flex-shrink: 0;
          }
          
          .subactions-section-rich {
            margin-bottom: 24px;
          }
          
          .subactions-list-rich {
            display: flex;
            flex-direction: column;
            gap: 8px;
          }
          
          .subaction-item-rich {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: rgba(249, 250, 251, 0.8);
            border-radius: 8px;
            border: 1px solid rgba(226, 232, 240, 0.6);
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #1e293b;
            transition: all 0.2s;
          }
          
          .subaction-item-rich:hover {
            background: rgba(139, 92, 246, 0.03);
            border-color: rgba(139, 92, 246, 0.2);
          }
          
          .subaction-item-rich .check-pending {
            color: #d1d5db;
          }
          
          .subaction-item-rich .check-completed {
            color: #10b981;
          }
          
          .subaction-completed {
            text-decoration: line-through;
            color: #9ca3af;
          }
          
          .notes-text-rich {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #64748b;
            line-height: 1.7;
            margin: 0;
            padding: 16px;
            background: rgba(249, 250, 251, 0.8);
            border-radius: 12px;
            border: 1px solid rgba(226, 232, 240, 0.6);
          }
          
          /* Edit Header */
          .edit-header-rich {
            margin-bottom: 28px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(226, 232, 240, 0.6);
          }
          
          .edit-header-rich h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: #1e293b;
            margin: 0 0 8px 0;
          }
          
          .edit-header-rich p {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #64748b;
            margin: 0;
          }
          
          /* Form Styles */
          .form-field-rich {
            margin-bottom: 20px;
          }
          
          .form-field-rich label {
            display: block;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 8px;
          }
          
          .input-rich,
          .textarea-rich,
          .select-rich {
            width: 100%;
            padding: 12px 14px;
            background: white;
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 10px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #1e293b;
            transition: all 0.2s;
            box-sizing: border-box;
          }
          
          .input-rich:focus,
          .textarea-rich:focus,
          .select-rich:focus {
            outline: none;
            border-color: #8B5CF6;
            background: rgba(139, 92, 246, 0.02);
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
          }
          
          .textarea-rich {
            resize: vertical;
            min-height: 80px;
          }
          
          .form-row-rich {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
          }
          
          /* Footer */
          .modal-footer-rich {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 32px;
            border-top: 1px solid rgba(226, 232, 240, 0.6);
            background: rgba(249, 250, 251, 0.5);
          }
          
          .footer-left-rich,
          .footer-right-rich {
            display: flex;
            gap: 12px;
          }
          
          .btn-primary-rich,
          .btn-secondary-rich,
          .btn-icon-rich {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 11px 20px;
            border-radius: 10px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
          }
          
          .btn-primary-rich {
            background: linear-gradient(135deg, #8B5CF6 0%, #7c3aed 100%);
            color: white;
          }
          
          .btn-primary-rich:hover:not(:disabled) {
            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.4);
            transform: translateY(-2px);
          }
          
          .btn-primary-rich.completed {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
          }
          
          .btn-primary-rich:disabled {
            opacity: 0.5;
            cursor: not-allowed;
          }
          
          .btn-secondary-rich {
            background: white;
            border: 1px solid rgba(226, 232, 240, 0.8);
            color: #64748b;
          }
          
          .btn-secondary-rich:hover {
            background: rgba(249, 250, 251, 1);
            border-color: rgba(203, 213, 225, 1);
          }
          
          .btn-icon-rich {
            padding: 11px;
            background: white;
            border: 1px solid rgba(226, 232, 240, 0.8);
            color: #64748b;
          }
          
          .btn-icon-rich:hover {
            background: rgba(139, 92, 246, 0.05);
            border-color: #8B5CF6;
            color: #8B5CF6;
          }
          
          .btn-icon-rich.copied {
            background: rgba(16, 185, 129, 0.1);
            border-color: #10b981;
            color: #10b981;
          }
          
          .btn-icon-rich.favorited {
            background: rgba(245, 158, 11, 0.1);
            border-color: #f59e0b;
          }
          
          .btn-icon-rich.favorited:hover {
            background: rgba(245, 158, 11, 0.15);
            border-color: #f59e0b;
          }
          
          /* Assignment Modal */
          .assign-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10001;
            backdrop-filter: blur(4px);
          }
          
          .assign-modal-content {
            background: white;
            border-radius: 16px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(226, 232, 240, 0.6);
          }
          
          .assign-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
            border-bottom: 1px solid rgba(226, 232, 240, 0.6);
          }
          
          .assign-modal-header h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 18px;
            font-weight: 600;
            color: #1e293b;
            margin: 0;
          }
          
          .assign-close-btn {
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            padding: 4px;
            border-radius: 6px;
            transition: all 0.2s;
          }
          
          .assign-close-btn:hover {
            background: rgba(100, 116, 139, 0.1);
            color: #1e293b;
          }
          
          .assign-modal-body {
            padding: 24px;
          }
          
          .assign-modal-footer {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
            padding: 16px 24px;
            border-top: 1px solid rgba(226, 232, 240, 0.6);
            background: rgba(249, 250, 251, 0.5);
          }
          
          @media (max-width: 768px) {
            .action-detail-modal-rich {
              max-height: 95vh;
            }
            
            .modal-header-rich,
            .modal-content-rich,
            .modal-footer-rich {
              padding-left: 20px;
              padding-right: 20px;
            }
            
            .form-row-rich,
            .metadata-grid-rich {
              grid-template-columns: 1fr;
            }
            
            .modal-footer-rich {
              flex-direction: column;
              gap: 12px;
            }
            
            .footer-left-rich,
            .footer-right-rich {
              width: 100%;
