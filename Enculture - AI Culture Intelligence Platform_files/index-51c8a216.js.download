          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1rem 1.5rem;
          border-bottom: 1px solid rgba(226, 232, 240, 0.6);
        }

        .insights-modal-controls {
          display: flex;
          align-items: flex-end;
