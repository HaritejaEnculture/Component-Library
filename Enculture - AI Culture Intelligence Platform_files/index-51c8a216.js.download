        .actions-container {
          min-height: 100vh;
          background: linear-gradient(135deg, #f3eeff 0%, #f5f1ff 20%, #f7f4ff 40%, #f9f7ff 60%, #fcfbff 80%, #ffffff 100%);
          padding: 32px;
          font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        }
        
        .actions-content {
          max-width: 1400px;
          margin: 0 auto;
        }
        
        .error-banner {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 16px 20px;
          background: rgba(220, 38, 38, 0.1);
          border: 1px solid rgba(220, 38, 38, 0.2);
          border-radius: 8px;
          margin-bottom: 24px;
        }
        
        .error-banner p {
          margin: 0;
          font-size: 14px;
          color: #dc2626;
          font-weight: 500;
          font-family: 'Poppins', sans-serif;
        }
        
        .retry-button {
          padding: 8px 16px;
          background: #dc2626;
          color: #fff;
          border: none;
          border-radius: 6px;
          font-size: 14px;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.2s ease;
          font-family: 'Poppins', sans-serif;
        }
        
        .retry-button:hover {
          background: #b91c1c;
        }
        
        @media (max-width: 768px) {
          .actions-container {
            padding: 16px;
          }
        }
