        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        .wordcloud-skeleton {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.99) 0%, rgba(251, 252, 254, 0.96) 50%, rgba(248, 250, 252, 0.94) 100%);
          backdrop-filter: blur(36px) saturate(190%);
          border-radius: 20px;
          border: 1.5px solid rgba(255, 255, 255, 0.8);
          box-shadow: 
            0 14px 45px rgba(0, 0, 0, 0.09),
            0 7px 22px rgba(0, 0, 0, 0.07),
            0 3px 10px rgba(0, 0, 0, 0.05),
            inset 0 1.5px 0 rgba(255, 255, 255, 0.98);
          width: 100%;
          box-sizing: border-box;
          overflow: hidden;
        }

        .wordcloud-skeleton-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1.25rem 1.75rem;
          border-bottom: 2px solid rgba(226, 232, 240, 0.5);
        }

        .wordcloud-skeleton-title {
          display: flex;
          align-items: center;
          gap: 0.5rem;
        }

        .wordcloud-skeleton-content {
          padding: 1rem;
          position: relative;
          height: 400px;
          overflow: hidden;
        }

        .wordcloud-skeleton-cloud {
          position: relative;
          width: 100%;
          height: 100%;
        }

        .skeleton-word {
          position: absolute;
          background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%);
          background-size: 200% 100%;
          animation: skeleton-loading 1.5s ease-in-out infinite;
          border-radius: 6px;
          opacity: 0.8;
        }

        .wordcloud-skeleton-footer {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1rem 1.5rem;
          border-top: 1px solid rgba(226, 232, 240, 0.6);
        }

        .wordcloud-skeleton-legend {
          display: flex;
          gap: 1rem;
          align-items: center;
        }

        .skeleton-bar {
          background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%);
          background-size: 200% 100%;
          animation: skeleton-loading 1.5s ease-in-out infinite;
          border-radius: 4px;
        }

        @keyframes skeleton-loading {
          0% {
            background-position: 200% 0;
          }
          100% {
            background-position: -200% 0;
          }
        }
      `})]})},DZe=({surveyMappingId:e,wordCloudData:t,isWordCloudDataLoading:r})=>{const[n,a]=j.useState(!1),{data:i,isLoading:o,error:l}=Ba({queryKey:["wordCloudData",e],queryFn:()=>ua.getWordCloudData(e),staleTime:5*60*1e3,gcTime:10*60*1e3,enabled:!!e&&!t}),c=[{name:"No data found",value:5,sentiment:"neutral"}],d=v=>{var y,x,b;return v?((y=v==null?void 0:v.metadata)==null?void 0:y.Nvalue)!==void 0&&v.metadata.Nvalue!==null?parseInt(v.metadata.Nvalue):((b=(x=v==null?void 0:v.data)==null?void 0:x.metadata)==null?void 0:b.Nvalue)!==void 0&&v.data.metadata.Nvalue!==null?parseInt(v.data.metadata.Nvalue):0:0},u=v=>Array.isArray(v)?v:v&&Array.isArray(v.data)?v.data:v&&v.data&&Array.isArray(v.data.data)?v.data.data:c,p=t||(i==null?void 0:i.data),f=d(p),h=u(t)||u(i==null?void 0:i.data)||c,g=()=>a(!0),m=()=>a(!1);return r||o?s.jsx(IZe,{}):f>0&&f<=5?s.jsx(EZe,{title:"Sentiment cloud",icon:s.jsx(qC,{className:"w-8 h-8",style:{color:"#64748b"}}),mainMessage:"Insufficient responses",subMessage:"This chart cannot be displayed to maintain confidentiality as the number of respondents is 5 or less"}):l?s.jsxs(s.Fragment,{children:[s.jsx("div",{className:"wordcloud-error-card",children:s.jsxs("div",{className:"wordcloud-error-content",children:[s.jsx("div",{className:"wordcloud-error-icon",children:s.jsx(Cu,{className:"w-6 h-6"})}),s.jsx("div",{className:"wordcloud-error-text",children:s.jsx("div",{className:"wordcloud-error-title",children:"Error loading word cloud data"})})]})}),s.jsx("style",{jsx:!0,children:`
