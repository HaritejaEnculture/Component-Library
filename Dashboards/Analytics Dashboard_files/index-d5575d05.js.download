        .insights-card {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 252, 254, 0.95) 50%, rgba(248, 250, 252, 0.92) 100%);
          backdrop-filter: blur(32px) saturate(180%);
          border-radius: 18px;
          padding: 26px;
          box-shadow: 
            0 12px 40px rgba(0, 0, 0, 0.08),
            0 6px 20px rgba(0, 0, 0, 0.06),
            0 2px 8px rgba(0, 0, 0, 0.04),
            inset 0 1.5px 0 rgba(255, 255, 255, 0.95),
            inset 0 -1px 0 rgba(0, 0, 0, 0.03);
          border: 1.5px solid rgba(255, 255, 255, 0.75);
          position: relative;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          display: flex;
          flex-direction: column;
          height: 100%;
          min-height: 290px;
          box-sizing: border-box;
          min-width: 0;
          overflow: hidden;
        }

        .insights-card::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          border-radius: 18px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.15) 30%, transparent 60%, rgba(124, 58, 237, 0.03) 100%);
          pointer-events: none;
          opacity: 0.8;
          z-index: 0;
          transition: opacity 0.3s ease;
        }

        .insights-card > * {
          position: relative;
          z-index: 1;
        }

        .insights-card:hover {
          transform: translateY(-3px) scale(1.005);
          box-shadow: 
            0 16px 50px rgba(0, 0, 0, 0.11),
            0 8px 24px rgba(0, 0, 0, 0.08),
            0 3px 10px rgba(0, 0, 0, 0.05),
            inset 0 1.5px 0 rgba(255, 255, 255, 1),
            inset 0 -1px 0 rgba(0, 0, 0, 0.04);
          border-color: rgba(255, 255, 255, 0.9);
        }

        .insights-card:hover::before {
          opacity: 1;
        }

        .insights-card-skeleton {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.85) 0%, rgba(248, 250, 252, 0.8) 100%);
          backdrop-filter: blur(24px);
          border-radius: 16px;
          padding: 24px;
          border: 1px solid rgba(255, 255, 255, 0.6);
          box-shadow: 
            0 8px 32px rgba(0, 0, 0, 0.06),
            0 4px 16px rgba(0, 0, 0, 0.04),
            inset 0 1px 0 rgba(255, 255, 255, 0.8),
            inset 0 -1px 0 rgba(0, 0, 0, 0.02);
          position: relative;
          animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
          box-sizing: border-box;
        }

        .insights-card-skeleton::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          border-radius: 16px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, transparent 50%, rgba(255, 255, 255, 0.1) 100%);
          pointer-events: none;
          opacity: 0.7;
          z-index: 0;
        }

        .insights-card-skeleton > * {
          position: relative;
          z-index: 1;
        }

        @keyframes pulse {
          0%, 100% {
            opacity: 1;
          }
          50% {
            opacity: 0.5;
          }
        }

        .insights-cta-btn {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          width: auto;
          padding: 13px 18px;
          background: linear-gradient(135deg, #3F205F 0%, #4A2A6F 50%, #3F205F 100%);
          border: none;
          border-radius: 14px;
          font-size: 14px;
          font-weight: 700;
          color: #ffffff;
          font-family: 'Poppins', sans-serif;
          text-transform: uppercase;
          letter-spacing: 0.6px;
          cursor: pointer;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          box-shadow: 0 6px 16px rgba(63, 32, 95, 0.3), 0 2px 6px rgba(63, 32, 95, 0.2);
          margin: 0 auto;
          position: relative;
          overflow: hidden;
        }

        .insights-cta-btn::before {
          content: '';
          position: absolute;
          top: 0;
          left: -100%;
          width: 100%;
          height: 100%;
          background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
          transition: left 0.5s ease;
        }

        .insights-cta-btn:hover::before {
          left: 100%;
        }

        .insights-cta-btn:hover {
          background: linear-gradient(135deg, #4A2A6F 0%, #5A3A7F 50%, #4A2A6F 100%);
          transform: translateY(-2px) scale(1.02);
          box-shadow: 0 8px 20px rgba(63, 32, 95, 0.4), 0 4px 10px rgba(63, 32, 95, 0.3);
        }

        .insights-cta-btn:active {
          transform: translateY(0) scale(1);
          box-shadow: 0 3px 10px rgba(63, 32, 95, 0.3), 0 1px 4px rgba(63, 32, 95, 0.2);
        }

        .insights-cta-btn :global(svg) {
          color: #ffffff;
        }

        .insight-banner {
          width: calc(100% + 48px);
          height: 40px;
          border-radius: 16px 16px 0 0;
          display: flex;
          align-items: center;
          gap: 12px;
          padding-left: 12px;
          margin: -24px -24px 12px -24px;
        }

        .insight-icon-container {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 24px;
          height: 24px;
          flex-shrink: 0;
        }

        .insight-label {
          font-size: 12px;
          font-weight: 600;
          white-space: nowrap;
        }
