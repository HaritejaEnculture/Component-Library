        .board-view-container {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 20px;
          padding: 20px 0;
        }
        
        .board-column {
          background: rgba(255, 255, 255, 0.5);
          border-radius: 16px;
          overflow: hidden;
          min-height: 400px;
          border: 1px solid rgba(226, 232, 240, 0.6);
          transition: all 0.2s ease;
        }
        
        .board-column.is-drag-over {
          border-color: rgba(139, 92, 246, 0.6);
          background: rgba(139, 92, 246, 0.05);
          box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1),
                      0 8px 24px rgba(139, 92, 246, 0.15);
          transform: scale(1.01);
        }
        
        .board-column-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 20px 24px;
          background: rgba(255, 255, 255, 0.9);
          border-bottom: 1px solid rgba(226, 232, 240, 0.6);
        }
        
        .board-column.is-drag-over .board-column-header {
          background: rgba(139, 92, 246, 0.08);
          border-bottom-color: rgba(139, 92, 246, 0.2);
        }
        
        .column-title {
          font-family: 'Poppins', sans-serif;
          font-size: 15px;
          font-weight: 600;
          color: #374151;
          margin: 0;
        }
        
        .column-count {
          font-family: 'Poppins', sans-serif;
          font-size: 13px;
          font-weight: 600;
          color: #8B5CF6;
          background: rgba(139, 92, 246, 0.1);
          padding: 4px 10px;
          border-radius: 12px;
        }
        
        .board-column-content {
          padding: 16px;
          min-height: 300px;
          position: relative;
        }
        
        .board-empty {
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 40px 20px;
          color: #9ca3af;
          font-family: 'Poppins', sans-serif;
          font-size: 14px;
        }
        
        .drop-zone-indicator {
          position: absolute;
          bottom: 16px;
          left: 16px;
          right: 16px;
          padding: 24px;
          border: 2px dashed rgba(139, 92, 246, 0.5);
          border-radius: 12px;
          background: rgba(139, 92, 246, 0.08);
          display: flex;
          align-items: center;
          justify-content: center;
          animation: pulse 1.5s ease-in-out infinite;
        }
        
        .drop-zone-indicator span {
          font-family: 'Poppins', sans-serif;
          font-size: 14px;
          font-weight: 600;
          color: #8B5CF6;
        }
        
        @keyframes pulse {
          0%, 100% {
            opacity: 0.8;
            transform: scale(1);
          }
          50% {
            opacity: 1;
            transform: scale(1.02);
          }
        }
        
        @keyframes cascadeIn {
          from {
            opacity: 0;
            transform: translateY(-10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
        
        @media (max-width: 1200px) {
          .board-view-container {
            grid-template-columns: 1fr;
            gap: 16px;
          }
          
          .board-column {
            min-height: auto;
          }
        }
      `})]})},aDt=({actions:e,onActionSelect:t,onActionStatusChange:r,loading:n})=>{const[a,i]=j.useState("priority"),[o,l]=j.useState("asc");if(n)return s.jsx("div",{className:"table-loading",children:"Loading..."});const c=g=>{a===g?l(o==="asc"?"desc":"asc"):(i(g),l("asc"))},d=[...e].sort((g,m)=>{let v,y;switch(a){case"title":v=g.title.toLowerCase(),y=m.title.toLowerCase();break;case"priority":const x={critical:0,high:1,medium:2,low:3};v=x[g.priority]||4,y=x[m.priority]||4;break;case"status":const b={"in-progress":0,pending:1,completed:2};v=b[g.status]||3,y=b[m.status]||3;break;case"dueDate":v=new Date(g.dueDate||"9999-12-31"),y=new Date(m.dueDate||"9999-12-31");break;case"category":v=g.category||"",y=m.category||"";break;default:return 0}return v<y?o==="asc"?-1:1:v>y?o==="asc"?1:-1:0}),u=g=>g.status==="completed",p=({column:g})=>a!==g?null:o==="asc"?s.jsx(Vk,{size:14}):s.jsx(oi,{size:14}),f=g=>({critical:"Critical",high:"High",medium:"Medium",low:"Low"})[g]||g,h=g=>({pending:"Pending","in-progress":"In Progress",completed:"Completed"})[g]||g;return s.jsxs("div",{className:"table-view-container-new",children:[s.jsx("svg",{style:{position:"absolute",width:0,height:0},children:s.jsx("defs",{children:s.jsxs("linearGradient",{id:"completedGradientTable",x1:"0%",y1:"0%",x2:"100%",y2:"100%",children:[s.jsx("stop",{offset:"0%",style:{stopColor:"#10b981",stopOpacity:1}}),s.jsx("stop",{offset:"100%",style:{stopColor:"#059669",stopOpacity:1}})]})})}),s.jsxs("table",{className:"actions-table-new",children:[s.jsx("thead",{children:s.jsxs("tr",{children:[s.jsx("th",{className:"th-checkbox",onClick:g=>g.stopPropagation(),children:s.jsx("div",{className:"th-content-new"})}),s.jsx("th",{className:"th-title",onClick:()=>c("title"),children:s.jsxs("div",{className:"th-content-new",children:[s.jsx("span",{children:"Title"}),s.jsx(p,{column:"title"})]})}),s.jsx("th",{className:"th-priority",onClick:()=>c("priority"),children:s.jsxs("div",{className:"th-content-new",children:[s.jsx("s