        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        .insights-modal-dropdown {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 250, 252, 0.95) 100%);
          backdrop-filter: blur(24px);
          border-radius: 16px;
          box-shadow: 
            0 20px 60px rgba(0, 0, 0, 0.15),
            0 8px 32px rgba(0, 0, 0, 0.1);
          border: 1px solid rgba(255, 255, 255, 0.8);
          display: flex;
          flex-direction: column;
          overflow: hidden;
          font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        }

        .insights-search-input {
          width: 100%;
          padding: 0.5rem 2.5rem 0.5rem 2.5rem;
          border: 1px solid rgba(226, 232, 240, 0.6);
          border-radius: 8px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%);
          backdrop-filter: blur(10px);
          font-size: 0.875rem;
          color: #1e293b;
          font-family: 'Poppins', sans-serif;
          transition: all 0.3s ease;
          position: relative;
          z-index: 0;
        }

        .insights-search-input:focus {
          outline: none;
          border-color: rgba(196, 181, 253, 0.5);
          box-shadow: 0 0 0 3px rgba(196, 181, 253, 0.1);
          background: rgba(255, 255, 255, 0.95);
        }

        .insights-search-input::placeholder {
          color: #94a3b8;
        }

        .insights-modal-option {
          width: 100%;
          padding: 0.75rem 1rem;
          border: 1px solid rgba(226, 232, 240, 0.4);
          border-radius: 8px;
          background: transparent;
          cursor: pointer;
          text-align: left;
          display: flex;
          align-items: center;
          transition: all 0.3s ease;
          font-family: 'Poppins', sans-serif;
          font-size: 0.875rem;
          font-weight: 400;
          color: #1e293b;
          line-height: 1.5;
        }

        .insights-modal-option:hover {
          background: linear-gradient(135deg, rgba(248, 250, 252, 0.8) 0%, rgba(241, 245, 249, 0.7) 100%);
          border-color: rgba(196, 181, 253, 0.3);
          transform: translateX(2px);
        }

        .insights-modal-option.active {
          background: linear-gradient(135deg, rgba(224, 231, 255, 0.5) 0%, rgba(241, 245, 249, 0.6) 100%);
          border-color: rgba(196, 181, 253, 0.4);
        }

        .insights-modal-option span {
          font-family: 'Poppins', sans-serif;
        }

        .insights-modal-overlay {
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          width: 100vw;
          height: 100vh;
          z-index: 10000;
          background: rgba(0, 0, 0, 0.6);
          backdrop-filter: blur(8px);
          -webkit-backdrop-filter: blur(8px);
          box-sizing: border-box;
        }

        .insights-modal-header-section {
          padding: 0.5rem 1rem;
          border-bottom: 1px dashed rgba(196, 181, 253, 0.4);
          margin-bottom: 8px;
        }

        .insights-modal-header-section h3 {
          font-size: 0.875rem;
          font-weight: 500;
          color: #475569;
          font-family: 'Poppins', sans-serif;
          margin: 0;
        }

        .insights-modal-divider {
          border-bottom: 1px dashed rgba(196, 181, 253, 0.3);
          height: 1px;
          margin-top: 8px;
          margin-bottom: 0;
          width: 100%;
        }

        .insights-modal-divider-large {
          border-bottom: 1px dashed rgba(196, 181, 253, 0.3);
          height: 1px;
          margin-top: 16px;
          margin-bottom: 16px;
          width: 100%;
        }
      `})]})},YQe="https://cz095feibl.execute-api.us-east-1.amazonaws.com/prod/",qQe={}.VITE_RESULT_SERVICE_URL||"https://5yi4q4u4xe.execute-api.us-east-1.amazonaws.com/prod/";let t4="https://aggqef0qv4.execute-api.us-east-1.amazonaws.com/prod/";t4=t4.replace(/\/$/,"");t4=t4.replace(/\/api\/v1$/,"");const KQe="https://gjvdfq33nb.execute-api.us-east-1.amazonaws.com/prod/",Xve="https://vb6vudn1d2.execute-api.us-east-1.amazonaws.com/prod/";console.log("SURVEY_CORE_SERVICE_URL:",Xve);const ZQe="https://kc03ho7kac.execute-api.us-east-1.amazonaws.com/prod/",XQe="https://4f81z2p5e1.execute-api.us-east-1.amazonaws.com/prod/",QQe="https://b6w3j7wgag.execute-api.us-east-1.amazonaws.com/prod/",JQe="https://er3t0v9zbk.execute-api.us-east-1.amazonaws.com/prod/",eJe="https://bwreyzr9vh.execute-api.us-east-1.amazonaws.com/prod/",tJe="https://81sv2a4ax8.execute-api.us-east-1.amazonaws.com/prod/",Lu=e=>{const t=Ii.create({baseURL:e,headers:{"Content-Type":"application/json"}});return t.interceptors.request.use(r=>{const n=localStorage.getItem("token")||localStorage.getItem("accessToken"),a=localStorage.getItem("tenantToken");return n&&(r.headers.Authorization=`Bearer ${n}`),a&&(r.headers["x-tenant-token"]=a),r}),t},Ci=Lu(YQe),Qp=Lu(t4),tp=Lu(KQe),uc=Lu(Xve),Jp=Lu(ZQe),Ku=Lu(XQe),$6=Lu(qQe),ef=Lu(QQe),ro=Lu(JQe),rJe=Lu(eJe),BJ=Lu(tJe),Yv=e=>{const{search:t="",sortBy:r="createdAt",sortOrder:n="desc",page:a=1,limit:i=10,payloadForDashboardFilters:o=[]}=e,l=Array.isArray(o)&&o.length===0?"[]":JSON.stringify(o);return{search:t||"",sortBy:r||"createdAt",sortOrder:n||"desc",page:a.toString(),limit:i.toString(),payloadForDashboardFilters:l}},gs={getSurveyData:async()=>(await uc.get("/survey-data")).data,createSurveyMetadata:async e=>(await uc.post("/survey-metadata",e)).data,updateSurveyMetadata:async(e,t)=>(await uc.patch(`/survey-metadata/${e}`,t)).data,updateSurveyMapping:async(e,t)=>(await uc.patch(`/survey-mapping/${e}`,t)).data,getSurveyById:async e=>(await uc.get(`/survey-templates/$