        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        .dashboard-chart-skeleton {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 252, 254, 0.95) 50%, rgba(248, 250, 252, 0.92) 100%);
          backdrop-filter: blur(32px) saturate(180%);
          border-radius: 18px;
          padding: 0;
          border: 1.5px solid rgba(255, 255, 255, 0.75);
          box-shadow: 
            0 12px 40px rgba(0, 0, 0, 0.08),
            0 6px 20px rgba(0, 0, 0, 0.06),
            0 2px 8px rgba(0, 0, 0, 0.04),
            inset 0 1.5px 0 rgba(255, 255, 255, 0.95),
            inset 0 -1px 0 rgba(0, 0, 0, 0.03);
          width: 100%;
          box-sizing: border-box;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          position: relative;
          overflow: hidden;
          display: flex;
          flex-direction: column;
        }

        .dashboard-chart-skeleton::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          border-radius: 18px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.15) 30%, transparent 60%, rgba(124, 58, 237, 0.03) 100%);
          pointer-events: none;
          opacity: 0.8;
          z-index: 0;
          transition: opacity 0.3s ease;
        }

        .dashboard-chart-skeleton-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1.25rem 1.75rem;
          border-bottom: 2px solid rgba(226, 232, 240, 0.5);
          position: relative;
          z-index: 1;
        }

        .dashboard-chart-skeleton-title {
          display: flex;
          align-items: center;
          gap: 0.5rem;
        }

        .dashboard-chart-skeleton-content {
          width: 100%;
          box-sizing: border-box;
          position: relative;
          z-index: 1;
          flex: 1;
          padding: 1rem 2rem;
        }

        .dashboard-chart-skeleton-chart {
          height: 250px;
          display: flex;
          align-items: flex-end;
          justify-content: center;
          gap: 0.5rem;
        }

        .dashboard-chart-skeleton-comments {
          margin: 1.5rem;
          display: flex;
          flex-direction: column;
          gap: 1rem;
          position: relative;
          z-index: 1;
        }

        .dashboard-chart-skeleton-comments-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding-bottom: 0.75rem;
          border-bottom: 2px solid #e2e8f0;
          margin-bottom: 0.5rem;
        }

        .dashboard-chart-skeleton-comments-content {
          min-height: 160px;
          display: flex;
          flex-direction: column;
          gap: 0.75rem;
        }

        .skeleton-bar {
          background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%);
          background-size: 200% 100%;
          animation: skeleton-loading 1.5s ease-in-out infinite;
          border-radius: 4px;
        }

        @keyframes skeleton-loading {
          0% {
            background-position: 200% 0;
          }
          100% {
            background-position: -200% 0;
          }
        }
