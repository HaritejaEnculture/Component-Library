        .actions-list-container {
          padding: 20px 0;
        }
        
        .priority-group {
          margin-bottom: 32px;
        }
        
        .priority-group:last-child {
          margin-bottom: 0;
        }
        
        .priority-group-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 0 4px 12px 4px;
          border-bottom: 1px solid rgba(139, 92, 246, 0.15);
          margin-bottom: 16px;
        }
        
        .priority-title {
          font-family: 'Poppins', sans-serif;
          font-size: 14px;
          font-weight: 600;
          color: #64748b;
          margin: 0;
          text-transform: uppercase;
          letter-spacing: 0.5px;
        }
        
        .priority-count {
          font-family: 'Poppins', sans-serif;
          font-size: 12px;
          font-weight: 600;
          color: #8B5CF6;
          background: rgba(139, 92, 246, 0.1);
          padding: 4px 10px;
          border-radius: 12px;
        }
        
        .priority-group-items {
          display: flex;
          flex-direction: column;
        }
        
        .action-item-wrapper {
          animation: cascadeIn 0.3s ease both;
        }
        
        @keyframes cascadeIn {
          from {
            opacity: 0;
            transform: translateY(-10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
        
        @media (max-width: 768px) {
          .actions-list-container {
            padding: 16px 0;
          }
          
          .priority-group {
            margin-bottom: 24px;
          }
          
          .priority-group-header {
            padding-bottom: 10px;
            margin-bottom: 12px;
          }
          
          .priority-title {
            font-size: 13px;
          }
        }
