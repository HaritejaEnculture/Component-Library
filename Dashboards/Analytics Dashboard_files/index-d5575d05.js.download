        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        .summary-card-skeleton {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 252, 254, 0.95) 50%, rgba(248, 250, 252, 0.92) 100%);
          backdrop-filter: blur(32px) saturate(180%);
          border-radius: 16px;
          padding: 20px;
          box-shadow: 
            0 10px 35px rgba(0, 0, 0, 0.07),
            0 5px 18px rgba(0, 0, 0, 0.05),
            0 2px 8px rgba(0, 0, 0, 0.03),
            inset 0 1px 0 rgba(255, 255, 255, 0.9),
            inset 0 -1px 0 rgba(0, 0, 0, 0.02);
          border: 1px solid rgba(255, 255, 255, 0.7);
          position: relative;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          display: flex;
          flex-direction: column;
          gap: 12px;
          width: 100%;
          min-height: 200px;
          box-sizing: border-box;
          overflow: hidden;
          animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        .summary-card-skeleton::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          border-radius: 16px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 30%, transparent 60%, rgba(124, 58, 237, 0.02) 100%);
          pointer-events: none;
          opacity: 0.6;
          z-index: 0;
          transition: opacity 0.3s ease;
        }

        .summary-card-skeleton > * {
          position: relative;
          z-index: 1;
        }

        @keyframes pulse {
          0%, 100% {
            opacity: 1;
          }
          50% {
            opacity: 0.5;
          }
        }

        .insights-card-skeleton {
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 252, 254, 0.95) 50%, rgba(248, 250, 252, 0.92) 100%);
          backdrop-filter: blur(32px) saturate(180%);
          border-radius: 18px;
          padding: 26px;
          box-shadow: 
            0 12px 40px rgba(0, 0, 0, 0.08),
            0 6px 20px rgba(0, 0, 0, 0.06),
            0 2px 8px rgba(0, 0, 0, 0.04),
            inset 0 1.5px 0 rgba(255, 255, 255, 0.95),
            inset 0 -1px 0 rgba(0, 0, 0, 0.03);
          border: 1.5px solid rgba(255, 255, 255, 0.75);
          position: relative;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          display: flex;
          flex-direction: column;
          height: 100%;
          min-height: 290px;
          box-sizing: border-box;
          min-width: 0;
          overflow: hidden;
          animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        .insights-card-skeleton::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          border-radius: 18px;
          background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.15) 30%, transparent 60%, rgba(124, 58, 237, 0.03) 100%);
          pointer-events: none;
          opacity: 0.8;
          z-index: 0;
          transition: opacity 0.3s ease;
        }

        .insights-card-skeleton > * {
          position: relative;
          z-index: 1;
        }
      `})]},`${e}-${a}`)},rU=e=>s.jsx(WQe,{...e}),VQe=()=>s.jsx("svg",{xmlns:"http://www.w3.org/2000/svg",width:"14",height:"9",viewBox:"0 0 14 9",fill:"none",children:s.jsx("path",{fillRule:"evenodd",clipRule:"evenodd",d:"M13.5172 0.88113C13.8479 1.28651 13.8243 1.88375 13.4463 2.26215L7.60396 8.10414C7.40812 8.29998 7.14613 8.40599 6.87436 8.40599C6.6025 8.40599 6.34099 8.30016 6.14441 8.10414L0.302302 2.26203C-0.100767 1.85848 -0.100767 1.20527 0.302302 0.80278C0.705508 0.399093 1.35889 0.399093 1.76188 0.80266L6.87436 5.91473L11.9867 0.80278C12.3647 0.424345 12.9626 0.400673 13.368 0.731783L13.4464 0.802736L13.5172 0.88113Z",fill:"#308282"})}),HQe=({selectedOption:e,onSelect:t,selectedDashboardName:r,selectedDashboardDescription:n,dropdownRef:a})=>s.jsxs(s.Fragment,{children:[s.jsxs("div",{className:"insights-dropdown",children:[s.jsxs("div",{ref:a,className:"insights-dropdown-trigger",children:[s.jsx("div",{className:"insights-dropdown-content",children:s.jsx("span",{className:"insights-dropdown-title",children:r||"Select Dashboard"})}),s.jsx("button",{onClick:()=>t(e),className:"insights-dropdown-button",children:s.jsx(VQe,{})})]}),s.jsx("div",{className:"insights-dropdown-description",children:s.jsx("span",{children:n||""})})]}),s.jsx("style",{jsx:!0,children:`
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        .insights-dropdown {
          font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        }

        .insights-dropdown-trigger {
          display: flex;
          align-items: center;
          justify-content: space-between;
          width: 500px;
          border-bottom: 1px solid rgba(226, 232, 240, 0.6);
          padding-bottom: 0.5rem;
          position: relative;
        }

        .insights-dropdown-content {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          flex: 1;
          min-width: 0;
        }

        .insights-dropdown-title {
          font-size: 1rem;
          font-weight: 500;
          color: #1e293b;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
          font-family: 'Poppins', sans-serif;
        }

